[Unit]
Description=Hyperliquid address monitor Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hlmonitor
WorkingDirectory=/opt/hlmonitor
ExecStart=/opt/hlmonitor/.venv/bin/python -m hlmonitor.tgbot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
